# Windows scripts must keep CRLF: cmd.exe and wscript.exe mis-parse LF endings.
* text=auto eol=lf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.vbs  text eol=crlf

*.md   text eol=lf
*.yml  text eol=lf
*.svg  text eol=lf

*.png binary
*.ico binary
*.apk binary
*.exe binary
*.dll binary
*.zip binary
# Nova's typefaces: under text=auto a font could be taken for text and have its
# bytes rewritten as line endings
*.ttf binary
*.otf binary

# so GitHub counts the project as PowerShell, not as VBScript
*.ps1 linguist-language=PowerShell
