<!--
  Backup: a copy of the phone on this PC, and putting one back. The top card
  takes the backup - one .zip file. The bottom card holds the one that is open
  and three lists of it: the backups this PC has, every file inside the open
  one, and its apps. The classic window has the same under Advanced > Backup;
  the work itself is ..\shared\Backup.ps1.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
    <StackPanel>
      <TextBlock Text="BACK THIS PHONE UP" Style="{StaticResource Caps}" Margin="0,0,0,3"/>
      <TextBlock Style="{StaticResource MutedLine}" TextWrapping="Wrap" Margin="0,0,0,8"
                 ToolTip="Chats, game saves, an app's own settings: Android does not let adb read them, and no tool without root can"
                 Text="What is inside an app cannot be read without root, by any tool. Everything below can."/>
      <WrapPanel Margin="0,0,0,10">
        <CheckBox x:Name="BackupFiles" Content="Phone files" IsChecked="True" Margin="0,4,18,4"
                  ToolTip="Photos, videos, downloads, documents - everything under /sdcard that Android lets adb read"/>
        <CheckBox x:Name="BackupApps" Content="Apps (APK files)" IsChecked="True" Margin="0,4,18,4"
                  ToolTip="The apps you installed, so they can be installed again later"/>
        <CheckBox x:Name="BackupPersonal" Content="Contacts, messages, calls" IsChecked="True" Margin="0,4,18,4"
                  ToolTip="Contacts can be put back; messages and the call log are saved to read, because adb cannot write them"/>
        <CheckBox x:Name="BackupSettings" Content="Settings and app list" IsChecked="True" Margin="0,4,18,4"
                  ToolTip="settings list, getprop, the installed packages and a device report, as text"/>
        <!-- off unless it is asked for: a card can hold more than the phone does -->
        <CheckBox x:Name="BackupCard" Content="Memory card" IsChecked="False" Margin="0,4,18,4"
                  ToolTip="What is on the card in the phone, if there is one. Off by default: a card can be bigger than the phone itself"/>
        <!-- packing reads and writes everything a second time - about 40% on top
             of the pull - so it is a choice, not a given -->
        <CheckBox x:Name="BackupPack" Content="Pack into one .zip" IsChecked="True" Margin="0,4,18,4"
                  ToolTip="One file instead of a folder, which is tidier to keep and to move. It costs a second pass over everything - about 40% more time - and a backup left as a folder can be brought up to date later instead of taken again"/>
      </WrapPanel>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Call it:" VerticalAlignment="Center" Style="{StaticResource MutedLine}"/>
        <TextBox x:Name="BackupName" Grid.Column="1" Width="240" Margin="8,0,0,0"
                 ToolTip="What to call this backup - &quot;before the update&quot;, &quot;holiday photos&quot;. It goes into the file name and shows in the list. Leave it empty and the phone and the time are name enough"/>
        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedLine}"
                   Text="optional - the phone and the time are in the name either way"/>
      </Grid>
      <!-- Which people on the phone this backup is of: Android keeps each
           user's files apart, and adb may read some of them. The list is read
           off the phone when the page is opened. -->
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Back up:" VerticalAlignment="Center" Style="{StaticResource MutedLine}"/>
        <ComboBox x:Name="BackupUsers" Grid.Column="1" Width="300" Margin="8,0,0,0"
                  ToolTip="Which user on the phone to back up: the main one, one of the others, or every user. The owner goes where it always has; anyone else goes into users\&lt;id&gt;\ inside the backup. A user whose files Android keeps shut is marked, and what can be read of them - their app list, settings and contacts - is still taken"/>
        <TextBlock x:Name="BackupUsersNote" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource MutedLine}" TextTrimming="CharacterEllipsis"
                   Text="read from the phone when this page is opened"/>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BackupRun" Style="{StaticResource Primary}" Content="Back up now ..."
                  ToolTip="Asks where to keep it, then writes one .zip named after this phone and the time"/>
          <Button x:Name="BackupCancel" Content="Cancel" Margin="8,0,0,0" IsEnabled="False"
                  ToolTip="Stops the backup or the restore where it is; what was already done stays"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="BackupProgressText" Style="{StaticResource MutedLine}" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" Text="Nothing running."/>
          <ProgressBar x:Name="BackupProgress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>

  <Border Grid.Row="1" Style="{StaticResource CardPanel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <!-- a floor under the lists: without it this row shrank to nothing at
             the smallest window and the three tabs had no body at all. A list
             inside a page that scrolls does not scroll itself, so the page
             does not: this row is what gives, and the lists keep their own
             scrollbars -->
        <RowDefinition Height="*" MinHeight="96"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Text="PUT A BACKUP BACK" Style="{StaticResource Caps}" Margin="0,0,0,6"/>

      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BackupOpen" Content="Open a backup ..." VerticalAlignment="Top"
                ToolTip="Pick the .zip file a backup is"/>
        <TextBlock x:Name="BackupInfo" Grid.Column="1" Grid.ColumnSpan="2" Margin="14,0,0,0"
                   Style="{StaticResource MutedLine}" TextWrapping="Wrap" Text="No backup opened yet."/>
      </Grid>

      <TabControl x:Name="BackupTabs" Grid.Row="2">
        <TabItem x:Name="BackupTabList" Header="My backups">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Backups in:" VerticalAlignment="Center" Style="{StaticResource MutedLine}"/>
              <TextBox x:Name="BackupWhere" Grid.Column="1" Margin="8,0,8,0"
                       ToolTip="The folder the list below looks in - type a path and press Enter, or use Browse"/>
              <Button x:Name="BackupBrowse" Grid.Column="2" Content="Browse ..."
                      ToolTip="Pick the folder your backups are kept in"/>
            </Grid>
            <ListView x:Name="BackupList" Grid.Row="1" SelectionMode="Single"
                      ToolTip="The backups in that folder, newest first - double-click one to open it, or right-click one for the rest">
              <ListView.ContextMenu>
                <!-- what a backup in this list can have done to it. On the menu
                     rather than on buttons of their own: the row underneath had
                     a second "Show in Explorer" on it, for the backup that is
                     open rather than the one picked here. -->
                <ContextMenu>
                  <MenuItem x:Name="BackupMenuOpen" Header="Open this one"
                            ToolTip="Opens the selected backup, so what is inside it can be read and put back"/>
                  <MenuItem x:Name="BackupMenuShow" Header="Show in Explorer"
                            ToolTip="Opens Explorer with the backup picked in this list picked out"/>
                  <MenuItem x:Name="BackupMenuResume" Header="Continue / update"
                            ToolTip="Carries a backup that stopped part way on from where it got to, or brings a finished one up to date - either way only what is missing or changed is fetched"/>
                  <Separator/>
                  <MenuItem x:Name="BackupMenuDelete" Header="Delete ..."
                            ToolTip="Deletes the selected backup from this PC, after asking. There is no undoing it, and the phone is not touched"/>
                </ContextMenu>
              </ListView.ContextMenu>
              <ListView.View>
                <GridView>
                    <GridViewColumn Header="NAME" Width="140" DisplayMemberBinding="{Binding Called}"/>
                  <GridViewColumn Header="TAKEN" Width="175" DisplayMemberBinding="{Binding When}"/>
                  <GridViewColumn Header="PHONE" Width="170" DisplayMemberBinding="{Binding Phone}"/>
                  <GridViewColumn Header="HOLDS" Width="150" DisplayMemberBinding="{Binding Holds}"/>
                  <GridViewColumn Header="SIZE" Width="80" DisplayMemberBinding="{Binding Size}"/>
                  <GridViewColumn Header="STATE" Width="120" DisplayMemberBinding="{Binding State}"/>
                  <GridViewColumn Header="FILE" Width="360" DisplayMemberBinding="{Binding Name}"/>
                </GridView>
              </ListView.View>
            </ListView>
            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
              <Button x:Name="BackupListRefresh" Content="Refresh" Margin="0,4,8,0"
                      ToolTip="Reads that folder again, in case a backup was added to it or taken out"/>
              <Button x:Name="BackupListOpen" Style="{StaticResource Primary}" Content="Open this one" Margin="0,4,8,0"
                      ToolTip="Opens the selected backup, so what is inside it can be read and put back"/>
              <TextBlock Style="{StaticResource MutedLine}" VerticalAlignment="Center" Margin="4,4,0,0"
                         Text="Right-click a backup to show it in Explorer, carry it on, or delete it."/>
            </WrapPanel>
          </Grid>
        </TabItem>

        <TabItem x:Name="BackupTabContacts" Header="Contacts">
          <Grid Margin="0,4,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="BackupContactsWhat" Style="{StaticResource MutedLine}" TextWrapping="Wrap"
                       Text="Open a backup to see the contacts in it."/>
            <ListView x:Name="BackupContactsList" Grid.Row="1" Margin="0,8,0,0"
                      ToolTip="The contacts this backup holds, as they will be put back">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="NAME" Width="280" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="NUMBER" Width="220" DisplayMemberBinding="{Binding Number}"/>
                  <GridViewColumn Header="WHERE IT WAS" Width="260" DisplayMemberBinding="{Binding From}"/>
                </GridView>
              </ListView.View>
            </ListView>
            <Grid Grid.Row="2" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="BackupContactsHow" VerticalAlignment="Center" Style="{StaticResource MutedLine}"
                         TextWrapping="Wrap" Margin="0,0,14,0"
                         Text="Into the phone's own contacts with nothing to tap, or into an account through the phone's import screen, which takes a tap there. Both take seconds."/>
              <Button x:Name="BackupRestoreContacts" Grid.Column="1" Style="{StaticResource Primary}"
                      Content="Restore contacts" VerticalAlignment="Center"
                      ToolTip="Puts the contacts back; it asks which way first"/>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem x:Name="BackupTabMessages" Header="Messages and calls">
          <Grid Margin="0,4,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="BackupMessagesWhat" Style="{StaticResource MutedLine}" TextWrapping="Wrap"
                       Text="Open a backup to see the messages and calls in it."/>
            <ListView x:Name="BackupMessagesList" Grid.Row="1" Margin="0,8,0,0"
                      ToolTip="What this backup holds of the messages and the call log">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="WHAT" Width="140" DisplayMemberBinding="{Binding What}"/>
                  <GridViewColumn Header="HOW MANY" Width="120" DisplayMemberBinding="{Binding Count}"/>
                  <GridViewColumn Header="WHERE IT WAS" Width="300" DisplayMemberBinding="{Binding Path}"/>
                </GridView>
              </ListView.View>
            </ListView>
            <Grid Grid.Row="2" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="BackupMessagesHow" VerticalAlignment="Center" Style="{StaticResource MutedLine}"
                         TextWrapping="Wrap" Margin="0,0,14,0"
                         Text="What the phone already has is left alone. The call log goes back read, so no old call shows up as missed."/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackupSaveMessages" Content="Save to a file ..." Margin="0,0,8,0"
                        ToolTip="Writes the messages and the call log out of the backup to a folder on this PC"/>
                <Button x:Name="BackupRestoreCalls" Content="Restore calls" Margin="0,0,8,0"
                        ToolTip="Puts the call log back on the phone; about 40 calls a second"/>
                <Button x:Name="BackupRestoreMessages" Style="{StaticResource Primary}" Content="Restore messages"
                        ToolTip="Puts the text messages back on the phone; about 13 a second"/>
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem x:Name="BackupTabInside" Header="Files">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListView x:Name="BackupInside" SelectionMode="Extended"
                      ToolTip="Every file in the opened backup, read from the zip itself - nothing is unpacked to show it">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="WHAT" Width="90" DisplayMemberBinding="{Binding What}"/>
                  <GridViewColumn Header="WHERE IT WAS" Width="560" DisplayMemberBinding="{Binding Path}"/>
                  <GridViewColumn Header="SIZE" Width="90" DisplayMemberBinding="{Binding Size}"/>
                </GridView>
              </ListView.View>
            </ListView>
            <Grid Grid.Row="1" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Find:" VerticalAlignment="Center" Style="{StaticResource MutedLine}"/>
              <TextBox x:Name="BackupFind" Grid.Column="1" Width="180" Margin="8,0,0,0"
                       ToolTip="Shows only the files whose path holds this text; empty it to see them all"/>
              <TextBlock x:Name="BackupInsideCount" Grid.Column="2" Margin="14,0,8,0" VerticalAlignment="Center"
                         Style="{StaticResource MutedLine}" TextTrimming="CharacterEllipsis" Text="Nothing open."/>
              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="BackupSaveCopy" Content="Save a copy ..." Margin="0,0,8,0"
                        ToolTip="Writes the picked files out of the backup into a folder on this PC; no phone is needed"/>
                <Button x:Name="BackupRestoreFiles" Style="{StaticResource Primary}" Content="Restore files ..."
                        ToolTip="Sends the files back to the phone; it asks first about the ones the phone already has"/>
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem x:Name="BackupTabApps" Header="Apps">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListView x:Name="BackupAppList" SelectionMode="Extended"
                      ToolTip="The apps in the backup. The ones this phone does not have are picked out for you - press Install picked apps below">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="APP" Width="200" DisplayMemberBinding="{Binding Shown}"/>
                  <GridViewColumn Header="PACKAGE" Width="250" DisplayMemberBinding="{Binding Package}"/>
                  <GridViewColumn Header="IN THE BACKUP" Width="120" DisplayMemberBinding="{Binding Held}"/>
                  <GridViewColumn Header="SIZE" Width="90" DisplayMemberBinding="{Binding Size}"/>
                  <GridViewColumn Header="ON THIS PHONE" Width="170" DisplayMemberBinding="{Binding Says}"/>
                </GridView>
              </ListView.View>
            </ListView>
            <Grid Grid.Row="1" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Find:" VerticalAlignment="Center" Style="{StaticResource MutedLine}"/>
              <TextBox x:Name="BackupAppFind" Grid.Column="1" Width="180" Margin="8,0,0,0"
                       ToolTip="Shows only the apps whose name or package holds this text"/>
              <Button x:Name="BackupAppsMissing" Grid.Column="2" Margin="8,0,0,0" Content="Pick the missing ones"
                      ToolTip="Picks out every app in the backup that this phone does not have"/>
              <TextBlock x:Name="BackupAppsCount" Grid.Column="3" Margin="14,0,14,0" VerticalAlignment="Center"
                         Style="{StaticResource MutedLine}" TextTrimming="CharacterEllipsis"
                         Text="Open a backup to see the apps in it."/>
              <Button x:Name="BackupInstallApps" Grid.Column="4" Style="{StaticResource Primary}"
                      Content="Install picked apps"
                      ToolTip="Installs the apps ticked above; a split app goes in one call"/>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>

      <WrapPanel Grid.Row="3" Margin="0,8,0,0">
        <Button x:Name="BackupRestoreAll" Style="{StaticResource Primary}" Content="Restore everything" Margin="0,4,8,0"
                Visibility="Collapsed"
                ToolTip="Puts back everything in the opened backup, one kind after another: contacts, then apps, then files. It says what it is about to do first"/>
        <Button x:Name="BackupShowFolder" Content="Show the open one" Margin="0,4,8,0"
                ToolTip="Opens Explorer with the backup that is open above picked out. The list has its own button for the row picked there"/>
        <TextBlock x:Name="BackupRestoreAllWhat" Margin="6,8,0,0" Style="{StaticResource MutedLine}"
                   TextTrimming="CharacterEllipsis"
                   Text="Open a backup, and each tab above puts its own part back."/>
      </WrapPanel>
    </Grid>
  </Border>

</Grid>
