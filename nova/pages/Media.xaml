<!--
  Camera and microphone: the phone camera as a video source in a scrcpy
  window, and the phone's sound played or recorded on the PC. Two cards, one
  job each; the page scrolls when the window is small.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,4,0">

      <!-- ======================================================= camera == -->
      <Border Style="{StaticResource CardPanel}">
        <StackPanel>
          <WrapPanel Margin="0,0,0,10">
            <TextBlock Text="CAMERA" Style="{StaticResource Caps}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="The phone camera as a video source, Android 12 or newer" Style="{StaticResource MutedLine}"
                       VerticalAlignment="Center"/>
          </WrapPanel>

          <WrapPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Camera" Style="{StaticResource FieldLabel}"/>
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="MediaCamera" Width="250"
                          ToolTip="The camera to stream when Facing is 'by id'"/>
                <Button x:Name="MediaCameraList" Content="List cameras" Margin="6,0,0,0"
                        ToolTip="Ask the phone which cameras it has (scrcpy --list-cameras)"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Facing" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="MediaCameraFacing" Width="110"
                        ToolTip="Pick a camera by id, or let scrcpy choose the first one facing this way"/>
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Size" Style="{StaticResource FieldLabel}"/>
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="MediaCameraSize" Width="130" IsEditable="True" ToolTip="scrcpy --camera-size"/>
                <Button x:Name="MediaCameraSizes" Content="Sizes" Margin="6,0,0,0"
                        ToolTip="Ask the phone which camera sizes it supports"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="FPS" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="MediaCameraFps" Width="76" IsEditable="True" ToolTip="scrcpy --camera-fps"/>
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Aspect" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="MediaCameraAr" Width="92" IsEditable="True"
                        ToolTip="Aspect ratio instead of an explicit size - scrcpy accepts only one of the two"/>
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Zoom" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="MediaCameraZoom" Width="70" IsEditable="True"
                        ToolTip="scrcpy --camera-zoom, 1 is no zoom. The camera must support it"/>
            </StackPanel>
          </WrapPanel>

          <WrapPanel>
            <CheckBox x:Name="MediaCameraHighSpeed" Content="High speed"
                      ToolTip="High frame rate capture (fewer sizes are available)"/>
            <CheckBox x:Name="MediaCameraTorch" Content="Torch" ToolTip="Turn the flash on while the camera streams"/>
            <CheckBox x:Name="MediaCameraMic" Content="Record microphone too"
                      ToolTip="Send the phone microphone with the camera (--audio-source=mic); off sends no sound"/>
          </WrapPanel>

          <DockPanel Margin="0,8,0,0">
            <CheckBox x:Name="MediaCameraRecord" DockPanel.Dock="Left" Content="Record to" VerticalAlignment="Center"
                      Margin="0,4,12,4" ToolTip="Also write the camera stream to this file (scrcpy --record)"/>
            <Button x:Name="MediaCameraBrowse" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"/>
            <TextBox x:Name="MediaCameraFile"
                     ToolTip="The recording. Left blank, a camera-date.mp4 in Videos is used"/>
          </DockPanel>

          <WrapPanel Margin="0,14,0,0">
            <Button x:Name="MediaCameraStart" Style="{StaticResource Primary}" Margin="0,0,8,6"
                    ToolTip="Stream the chosen camera to a window on the PC">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12"/>
                <TextBlock Text="Start camera" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="MediaCameraFront" Content="Front" Margin="0,0,8,6" ToolTip="Start the first front camera"/>
            <Button x:Name="MediaCameraBack" Content="Back" Margin="0,0,8,6" ToolTip="Start the first back camera"/>
            <Button x:Name="MediaCameraStop" Content="Stop camera" Margin="0,0,8,6"
                    ToolTip="Close every camera window started here"/>
            <Button x:Name="MediaCameraCommand" Style="{StaticResource Ghost}" Content="Show command" Margin="0,0,8,6"
                    ToolTip="Write the scrcpy command line to the log without starting anything"/>
          </WrapPanel>
          <TextBlock x:Name="MediaCameraHint" Style="{StaticResource MutedLine}" Margin="0,6,0,0"
                     Text="Streams the phone camera to a window on the PC (Android 12+). The phone screen stays untouched."/>
        </StackPanel>
      </Border>

      <!-- ======================================================== audio == -->
      <Border Style="{StaticResource CardPanel}" Margin="0,14,0,0">
        <StackPanel>
          <WrapPanel Margin="0,0,0,10">
            <TextBlock Text="MICROPHONE / AUDIO" Style="{StaticResource Caps}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Phone to PC" Style="{StaticResource MutedLine}" VerticalAlignment="Center"/>
          </WrapPanel>

          <WrapPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Source" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="MediaAudioSource" Width="220" ToolTip="scrcpy --audio-source"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
              <Button x:Name="MediaListen" Style="{StaticResource Primary}" Margin="0,0,8,0"
                      ToolTip="Stream that audio source from the phone to the PC speakers (no video)">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12"/>
                  <TextBlock Text="Listen" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="MediaListenStop" Content="Stop audio" Margin="0,0,8,0" IsEnabled="False"
                      ToolTip="Stop the audio stream or recording started here"/>
              <Button x:Name="MediaRecordAudio" Content="Record audio..."
                      ToolTip="Record that audio source to an .opus/.m4a file instead of playing it"/>
            </StackPanel>
          </WrapPanel>

          <WrapPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Codec" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="MediaAudioCodec" Width="104"
                        ToolTip="scrcpy --audio-codec. raw is uncompressed and needs a fast link"/>
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Encoder" Style="{StaticResource FieldLabel}"/>
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="MediaAudioEncoder" Width="230" IsEnabled="False"
                          ToolTipService.ShowOnDisabled="True"
                          ToolTip="scrcpy --audio-encoder. Only the encoders this phone has for the chosen codec are offered - press Codecs to read them. Not remembered between runs: the names differ from phone to phone"/>
                <Button x:Name="MediaAudioCodecs" Content="Codecs" Margin="6,0,0,0"
                        ToolTip="Ask the phone which audio codecs and encoders it really has, and fill the lists with them"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Bit rate" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="MediaAudioBitrate" Width="100" IsEditable="True" ToolTip="scrcpy --audio-bit-rate"/>
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Text="Buffer ms" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="MediaAudioBuffer" Width="76"
                       ToolTip="scrcpy --audio-buffer: lower is snappier, higher survives a busy link. Blank leaves the default"/>
            </StackPanel>
            <CheckBox x:Name="MediaAudioDup" Content="Keep playing on the phone too" VerticalAlignment="Bottom"
                      Margin="0,0,0,16"
                      ToolTip="scrcpy --audio-dup: sound comes out of both, instead of only the PC. Android 13 and newer, output source only"/>
          </WrapPanel>

          <TextBlock x:Name="MediaAudioHint" Style="{StaticResource MutedLine}" Margin="0,4,0,0"
                     Text="Phone -> PC only. Android gives no way to push PC audio to the phone speaker."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
