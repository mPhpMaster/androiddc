<!--
  Mirroring: scrcpy's picture, window, phone, target and input settings, and
  on a second inner page every other scrcpy option. The actions stay docked at
  the bottom of the page, reachable from both inner pages.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <!-- one field: a caption above its box, laid out in a WrapPanel -->
    <Style x:Key="MirroringField" TargetType="StackPanel">
      <Setter Property="Width" Value="150"/>
      <Setter Property="Margin" Value="0,0,14,10"/>
    </Style>
    <Style x:Key="MirroringCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!-- a one-line box as tall as the combo boxes beside it -->
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="9,0"/>
    </Style>
  </Grid.Resources>

  <DockPanel>
    <!-- ================================================ the actions ==== -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardPanel}" Padding="12,10" Margin="0,10,0,0">
      <WrapPanel>
        <Button x:Name="MirroringLaunch" Style="{StaticResource Primary}" Margin="0,0,8,0"
                ToolTip="Start scrcpy on every selected device, one window each">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}"/>
            <TextBlock Text="Launch scrcpy" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="MirroringShare" Content="Share internet + scrcpy" Margin="0,0,8,0"
                ToolTip="Start the internet sharing (unless it is already on), then scrcpy"/>
        <Button x:Name="MirroringLaunchOtg" Content="Launch OTG" Margin="0,0,8,0"
                ToolTip="Ticks OTG mode and starts scrcpy --otg: keyboard and mouse over USB, no picture. It restarts the adb server, which drops an active tunnel; the tunnel is rebuilt afterwards"/>
        <Button x:Name="MirroringCloseAll" Content="Close all scrcpy" Margin="0,0,8,0"
                ToolTip="Close every scrcpy window this program started"/>
        <Button x:Name="MirroringShowCommand" Style="{StaticResource Ghost}" Content="Show command"
                ToolTip="Print the exact scrcpy command line to the log, so you can reuse it"/>
      </WrapPanel>
    </Border>

    <TabControl x:Name="MirroringTabs">
      <!-- ========================================== inner page: Mirroring == -->
      <TabItem Header="Mirroring">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource MirroringCard}">
                <StackPanel>
                  <TextBlock Text="PICTURE" Style="{StaticResource Caps}"/>
                  <WrapPanel Margin="0,0,0,-10">
                    <StackPanel Style="{StaticResource MirroringField}" Width="96" Margin="0,0,10,10">
                      <TextBlock Text="Max size" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="MirroringMaxSize" IsEditable="True" ToolTip="0 = native resolution"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="96" Margin="0,0,10,10">
                      <TextBlock Text="Bit rate" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="MirroringBitrate" IsEditable="True" ToolTip="scrcpy -b, for example 8M"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="96" Margin="0,0,10,10">
                      <TextBlock Text="Max FPS" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="MirroringFps" IsEditable="True" ToolTip="0 = unlimited"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="170" Margin="0,0,0,10">
                      <TextBlock Text="Codec" Style="{StaticResource FieldLabel}"/>
                      <DockPanel>
                        <Button x:Name="MirroringCodecs" DockPanel.Dock="Right" Content="Codecs" Margin="6,0,0,0" Padding="10,0"
                                ToolTip="Ask the phone which video codecs it really has, and fill the list with them"/>
                        <ComboBox x:Name="MirroringCodec" ToolTip="scrcpy --video-codec"/>
                      </DockPanel>
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource MirroringCard}">
                <StackPanel>
                  <TextBlock Text="WINDOW" Style="{StaticResource Caps}"/>
                  <WrapPanel>
                    <CheckBox x:Name="MirroringFullscreen" Content="Fullscreen" ToolTip="scrcpy -f"/>
                    <CheckBox x:Name="MirroringBorderless" Content="Borderless" ToolTip="scrcpy --window-borderless"/>
                    <CheckBox x:Name="MirroringOnTop" Content="Always on top" ToolTip="scrcpy --always-on-top"/>
                    <CheckBox x:Name="MirroringNoScreensaver" Content="Disable screensaver" ToolTip="scrcpy --disable-screensaver: this PC does not blank while mirroring"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource MirroringCard}">
              <StackPanel>
                <TextBlock Text="WHILE MIRRORING, THE PHONE" Style="{StaticResource Caps}"/>
                <WrapPanel>
                  <CheckBox x:Name="MirroringScreenOff" Content="Turn screen off" ToolTip="scrcpy -S: the phone's own screen goes dark, the mirror stays"/>
                  <CheckBox x:Name="MirroringStayAwake" Content="Stay awake" IsChecked="True" ToolTip="scrcpy -w: the phone does not sleep while plugged in"/>
                  <CheckBox x:Name="MirroringNoAudio" Content="No audio" ToolTip="scrcpy --no-audio"/>
                  <CheckBox x:Name="MirroringViewOnly" Content="View only" ToolTip="Mirror without controlling the device (--no-control)"/>
                  <CheckBox x:Name="MirroringPowerOff" Content="Power off on close" ToolTip="scrcpy --power-off-on-close: the phone's screen turns off when the window closes"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource MirroringCard}">
              <StackPanel>
                <TextBlock Text="WHAT TO MIRROR, AND RECORDING" Style="{StaticResource Caps}"/>
                <WrapPanel>
                  <StackPanel Style="{StaticResource MirroringField}" Width="200">
                    <TextBlock Text="Display" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                      <Button x:Name="MirroringListDisplays" DockPanel.Dock="Right" Content="List displays" Margin="6,0,0,0" Padding="10,0"
                              ToolTip="Ask the phone which displays it has, and fill the list with their ids"/>
                      <ComboBox x:Name="MirroringDisplay" IsEditable="True" ToolTip="scrcpy --display-id; 0 is the phone's own screen"/>
                    </DockPanel>
                  </StackPanel>
                  <StackPanel Style="{StaticResource MirroringField}" Width="170">
                    <CheckBox x:Name="MirroringNewDisplay" Content="Virtual display" Margin="0,0,0,4"
                              ToolTip="scrcpy --new-display, e.g. 1920x1080/240"/>
                    <TextBox x:Name="MirroringNewDisplaySize" Text="1920x1080/240"
                             ToolTip="The virtual display's size and density, e.g. 1920x1080/240; blank lets scrcpy choose"/>
                  </StackPanel>
                  <StackPanel Style="{StaticResource MirroringField}" Width="290">
                    <TextBlock Text="Start app" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MirroringStartApp" IsEditable="True"
                              ToolTip="scrcpy --start-app. Open the list to pick an app by name - it is read from the phone - or type a package. A leading + force-stops the app first; a leading ? finds it by name"/>
                  </StackPanel>
                </WrapPanel>
                <Grid Margin="0,2,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="MirroringRecord" Content="Record to" VerticalAlignment="Center" Margin="0,0,12,0"
                            ToolTip="scrcpy --record; blank records to Videos with the date in the name"/>
                  <TextBox x:Name="MirroringRecordPath" Grid.Column="1" ToolTip="The file to record to; its extension decides the format unless More options says otherwise"/>
                  <Button x:Name="MirroringBrowseRecord" Grid.Column="2" Content="Browse..." Margin="8,0,0,0"
                          ToolTip="Choose the file to record to"/>
                </Grid>
                <TextBlock Text="Extra args" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="MirroringExtraArgs" ToolTip="Appended as-is, e.g. --crop=1080:1920:0:0 --window-title=&quot;Phone&quot;"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource MirroringCard}" Margin="0">
              <StackPanel>
                <TextBlock Text="KEYBOARD, MOUSE AND OTG" Style="{StaticResource Caps}"/>
                <WrapPanel Margin="0,0,0,-10">
                  <StackPanel Style="{StaticResource MirroringField}" Width="120">
                    <TextBlock Text="Mode" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="MirroringOtg" Content="OTG mode" Margin="0,7,0,7"
                              ToolTip="Physical keyboard/mouse over USB (AOA HID). No mirroring, no USB debugging needed, USB only."/>
                  </StackPanel>
                  <StackPanel Style="{StaticResource MirroringField}" Width="120">
                    <TextBlock Text="Keyboard" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MirroringKeyboard" ToolTip="scrcpy --keyboard"/>
                  </StackPanel>
                  <StackPanel Style="{StaticResource MirroringField}" Width="120">
                    <TextBlock Text="Mouse" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MirroringMouse" ToolTip="scrcpy --mouse"/>
                  </StackPanel>
                  <StackPanel Style="{StaticResource MirroringField}" Width="120">
                    <TextBlock Text="Gamepad" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MirroringGamepad" ToolTip="scrcpy --gamepad"/>
                  </StackPanel>
                  <StackPanel Style="{StaticResource MirroringField}" Width="150">
                    <TextBlock Text=" " Style="{StaticResource FieldLabel}"/>
                    <Button x:Name="MirroringKeyboardLayout" Content="Keyboard layout..."
                            ToolTip="Open the physical-keyboard layout settings on the device (needed once for uhid/aoa)"/>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ======================================== inner page: More options == -->
      <TabItem Header="More options">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Border Style="{StaticResource MirroringCard}">
                <StackPanel>
                  <TextBlock Text="RECORDING" Style="{StaticResource Caps}"/>
                  <WrapPanel Margin="0,0,0,-10">
                    <StackPanel Style="{StaticResource MirroringField}" Width="130">
                      <TextBlock Text="Format" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="MirroringRecordFormat" ToolTip="scrcpy --record-format; &quot;from the name&quot; lets the file extension decide"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="100">
                      <TextBlock Text="Rotate" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="MirroringRecordOrientation" ToolTip="scrcpy --record-orientation: how the saved file is rotated"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="150">
                      <TextBlock Text="Stop after (s, 0 = no limit)" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="MirroringTimeLimit" Text="0" ToolTip="scrcpy --time-limit in seconds; 0 means no limit"/>
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource MirroringCard}">
                <StackPanel>
                  <TextBlock Text="ORIENTATION" Style="{StaticResource Caps}"/>
                  <WrapPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="130">
                      <TextBlock Text="Window" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="MirroringOrientation" ToolTip="scrcpy --orientation: turns the picture on the PC only"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="130">
                      <TextBlock Text="Capture" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="MirroringCaptureOrientation" ToolTip="scrcpy --capture-orientation: turns what the phone sends; @ locks it"/>
                    </StackPanel>
                  </WrapPanel>
                  <TextBlock Text="Turning the capture also turns what is recorded." Style="{StaticResource MutedLine}"/>
                </StackPanel>
              </Border>

              <Border Grid.Row="1" Style="{StaticResource MirroringCard}">
                <StackPanel>
                  <TextBlock Text="NEW DISPLAY  (USED BY &quot;OWN SCRCPY WINDOW&quot;)" Style="{StaticResource Caps}" TextWrapping="Wrap"/>
                  <WrapPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="160">
                      <TextBlock Text="Keyboard" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="MirroringImePolicy" ToolTip="scrcpy --display-ime-policy: &quot;local&quot; keeps the keyboard on the new display"/>
                    </StackPanel>
                    <CheckBox x:Name="MirroringNoDecorations" Content="No system bars" VerticalAlignment="Bottom" Margin="0,0,18,16"
                              ToolTip="scrcpy --no-vd-system-decorations"/>
                  </WrapPanel>
                  <CheckBox x:Name="MirroringKeepContent" Content="Keep the apps running when the window closes" Margin="0,0,0,0"
                            ToolTip="scrcpy --no-vd-destroy-content"/>
                  <TextBlock Text="These apply when Virtual display is on." Style="{StaticResource MutedLine}" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

              <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MirroringCard}">
                <StackPanel>
                  <TextBlock Text="WINDOW ON THIS PC" Style="{StaticResource Caps}"/>
                  <WrapPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="70" Margin="0,0,8,10">
                      <TextBlock Text="x" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="MirroringWindowX" ToolTip="scrcpy --window-x, left blank to let Windows decide"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="70" Margin="0,0,8,10">
                      <TextBlock Text="y" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="MirroringWindowY" ToolTip="scrcpy --window-y, left blank to let Windows decide"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="70" Margin="0,0,8,10">
                      <TextBlock Text="width" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="MirroringWindowW" ToolTip="scrcpy --window-width, left blank to let Windows decide"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="70" Margin="0,0,14,10">
                      <TextBlock Text="height" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="MirroringWindowH" ToolTip="scrcpy --window-height, left blank to let Windows decide"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource MirroringField}" Width="110">
                      <TextBlock Text="Screen off after" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="MirroringScreenOffTimeout" ToolTip="scrcpy --screen-off-timeout in seconds, while mirroring only"/>
                    </StackPanel>
                  </WrapPanel>
                  <CheckBox x:Name="MirroringPrintFps" Content="Print the frame rate in the log" ToolTip="scrcpy --print-fps"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource MirroringCard}" Margin="0">
              <StackPanel>
                <TextBlock Text="KEYBOARD AND MOUSE" Style="{StaticResource Caps}"/>
                <WrapPanel>
                  <StackPanel Style="{StaticResource MirroringField}" Width="150">
                    <TextBlock Text="Shortcut key" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MirroringShortcutMod" ToolTip="scrcpy --shortcut-mod: which key starts a scrcpy shortcut"/>
                  </StackPanel>
                  <StackPanel Style="{StaticResource MirroringField}" Width="130">
                    <TextBlock Text="Mouse buttons" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MirroringMouseBind" ToolTip="scrcpy --mouse-bind, for example bhsn - leave blank for the default"/>
                  </StackPanel>
                </WrapPanel>
                <WrapPanel>
                  <CheckBox x:Name="MirroringPreferText" Content="Send text, not key codes" ToolTip="scrcpy --prefer-text: better for typing, worse for games"/>
                  <CheckBox x:Name="MirroringRawKeys" Content="Raw key events" ToolTip="scrcpy --raw-key-events"/>
                  <CheckBox x:Name="MirroringNoKeyRepeat" Content="No key repeat" ToolTip="scrcpy --no-key-repeat"/>
                  <CheckBox x:Name="MirroringLegacyPaste" Content="Legacy paste" ToolTip="scrcpy --legacy-paste: paste as keystrokes for apps that ignore the clipboard"/>
                </WrapPanel>
                <TextBlock Text="When the window closes" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                <WrapPanel>
                  <CheckBox x:Name="MirroringKillAdb" Content="Kill the adb server when scrcpy closes" ToolTip="scrcpy --kill-adb-on-close. It also drops any tunnel, so it is off by default"/>
                  <CheckBox x:Name="MirroringNoCleanup" Content="Leave the phone as it is on close" ToolTip="scrcpy --no-cleanup: do not restore the screen or clipboard afterwards"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Grid>
