<!--
  Overview - the home page: how the phone is doing, its screen, its details,
  and the handful of things done most often.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="480"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <!-- ================================================== left side ==== -->
      <StackPanel Grid.Column="0">
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="16,14">
            <StackPanel>
              <Grid>
                <TextBlock Text="BATTERY" Style="{StaticResource Caps}" Margin="0"/>
                <TextBlock Text="&#xE83F;" Style="{StaticResource Glyph}" Foreground="{StaticResource Brand}" HorizontalAlignment="Right"/>
              </Grid>
              <WrapPanel Margin="0,10,0,0">
                <TextBlock x:Name="OverviewBatteryValue" Text="--" Style="{StaticResource Metric}"/>
                <TextBlock x:Name="OverviewBatteryNote" FontSize="11.5" Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Bottom" Margin="8,0,0,3"/>
              </WrapPanel>
              <ProgressBar x:Name="OverviewBatteryBar" Margin="0,12,0,0" Maximum="100" Value="0" Foreground="{StaticResource Success}"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="16,14">
            <StackPanel>
              <Grid>
                <TextBlock Text="TEMPERATURE" Style="{StaticResource Caps}" Margin="0"/>
                <TextBlock Text="&#xE9CA;" Style="{StaticResource Glyph}" Foreground="{StaticResource Brand}" HorizontalAlignment="Right"/>
              </Grid>
              <WrapPanel Margin="0,10,0,0">
                <TextBlock x:Name="OverviewTempValue" Text="--" Style="{StaticResource Metric}"/>
                <TextBlock x:Name="OverviewTempNote" FontSize="11.5" Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Bottom" Margin="8,0,0,3"/>
              </WrapPanel>
              <ProgressBar x:Name="OverviewTempBar" Margin="0,12,0,0" Maximum="100" Value="0"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="4" Style="{StaticResource CardPanel}" Padding="16,14">
            <StackPanel>
              <Grid>
                <TextBlock Text="MEMORY" Style="{StaticResource Caps}" Margin="0"/>
                <TextBlock Text="&#xE964;" Style="{StaticResource Glyph}" Foreground="{StaticResource Brand}" HorizontalAlignment="Right"/>
              </Grid>
              <WrapPanel Margin="0,10,0,0">
                <TextBlock x:Name="OverviewMemoryValue" Text="--" Style="{StaticResource Metric}"/>
                <TextBlock x:Name="OverviewMemoryNote" FontSize="11.5" Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Bottom" Margin="8,0,0,3"/>
              </WrapPanel>
              <ProgressBar x:Name="OverviewMemoryBar" Margin="0,12,0,0" Maximum="100" Value="0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- the phone's screen, the first thing most visits are for -->
        <Border Style="{StaticResource SoftPanel}" Padding="24,22" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="72" Height="72" CornerRadius="16" Background="{StaticResource Card}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" VerticalAlignment="Top">
              <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BrandSoft}">
                <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="19" Foreground="{StaticResource Brand}"
                           HorizontalAlignment="Center"/>
              </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0">
              <TextBlock Text="Phone screen" Style="{StaticResource H1}"/>
              <TextBlock Style="{StaticResource MutedLine}" FontSize="13" LineHeight="21" Margin="0,4,0,14"
                         Text="See the screen here and tap, swipe or type on it, or mirror it in a window of its own with scrcpy, using the Mirroring settings."/>
              <WrapPanel>
                <Button x:Name="OverviewOpenScreen" Style="{StaticResource Primary}" Margin="0,0,8,6"
                        ToolTip="Open the Screen page and take a fresh picture">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
                    <TextBlock Text="Open screen" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="OverviewMirror" Margin="0,0,8,6"
                        ToolTip="Start scrcpy right away, using whatever is set on the Mirroring page">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEC15;" Style="{StaticResource Glyph}"/>
                    <TextBlock Text="Mirror with scrcpy" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource CardPanel}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="DEVICE DETAILS" Style="{StaticResource Caps}" Margin="0" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OverviewLoad" Content="Load details + screenshot" Margin="0,0,8,0"
                        ToolTip="Read the selected phone's details into the box below and grab its screen (F5)"/>
                <Button x:Name="OverviewCopy" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                        ToolTip="Copy the details"/>
              </StackPanel>
            </Grid>
            <Grid>
              <TextBox x:Name="OverviewDetails" Style="{StaticResource Console}" Height="250"/>
              <TextBlock x:Name="OverviewDetailsHint" Style="{StaticResource MutedLine}" Margin="16,14" IsHitTestVisible="False"
                         Text="Load details reads the model, build, screen, battery, network, Wi-Fi address, storage and uptime of the selected phone. Double-clicking a phone in the device picker does the same."/>
            </Grid>
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- ================================================= right side ==== -->
      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="QUICK ACTIONS" Style="{StaticResource Caps}"/>
            <UniformGrid Columns="2">
              <Button x:Name="OverviewTorch" Style="{StaticResource Tile}" Margin="0,0,5,10"
                      ToolTip="Android has no supported adb torch switch; this clicks the quick-settings tile and verifies the result">
                <StackPanel>
                  <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" Foreground="{StaticResource Brand}" HorizontalAlignment="Left"/>
                  <TextBlock Text="Torch" FontWeight="Medium" Margin="0,12,0,0"/>
                  <TextBlock Text="Quick settings tile" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="OverviewBuzz" Style="{StaticResource Tile}" Margin="5,0,0,10"
                      ToolTip="Ask the device to vibrate once (some ROMs ignore the shell vibrator)">
                <StackPanel>
                  <TextBlock Text="&#xE877;" Style="{StaticResource Glyph}" Foreground="{StaticResource Brand}" HorizontalAlignment="Left"/>
                  <TextBlock Text="Buzz" FontWeight="Medium" Margin="0,12,0,0"/>
                  <TextBlock Text="One vibration" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="OverviewReadStates" Style="{StaticResource Tile}" Margin="0,0,5,0"
                      ToolTip="Read every toggle below again and write them to the log">
                <StackPanel>
                  <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Foreground="{StaticResource Brand}" HorizontalAlignment="Left"/>
                  <TextBlock Text="Read states" FontWeight="Medium" Margin="0,12,0,0"/>
                  <TextBlock Text="Toggles, into the log" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="OverviewDevScreen" Style="{StaticResource Tile}" Margin="5,0,0,0"
                      ToolTip="Open developer options on the phone">
                <StackPanel>
                  <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Foreground="{StaticResource Brand}" HorizontalAlignment="Left"/>
                  <TextBlock Text="Developer" FontWeight="Medium" Margin="0,12,0,0"/>
                  <TextBlock Text="Options screen" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="QUICK TOGGLES" Style="{StaticResource Caps}" Margin="0,0,0,2"/>
            <TextBlock Style="{StaticResource MutedLine}" Margin="0,0,0,10"
                       Text="Applied to every selected device. The highlighted side is what the phone reports."/>
            <StackPanel x:Name="OverviewToggleHost"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}">
          <StackPanel>
            <TextBlock Text="PHONE NUMBER" Style="{StaticResource Caps}"/>
            <TextBlock Text="Number or USSD code" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="OverviewNumber" ToolTip="A phone number to call or text, or a USSD code such as *111#. Enter calls it."/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="OverviewCall" Style="{StaticResource Primary}" ToolTip="Confirm, then call the number">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE717;" Style="{StaticResource Glyph}"/>
                  <TextBlock Text="Call" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="OverviewHangUp" Grid.Column="2" Content="Hang up" ToolTip="Send the end-call key"/>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="OverviewSms" Content="Send SMS..." Margin="0,0,8,8"
                      ToolTip="Ask for the text, then compose it in the phone's SMS app"/>
              <Button x:Name="OverviewUssd" Content="Send USSD" Margin="0,0,8,8"
                      ToolTip="Dial a code like *111# - the operator answer appears on the phone screen"/>
              <Button x:Name="OverviewDialer" Content="Open dialer" Margin="0,0,0,8"
                      ToolTip="Put the number in the phone dialer without calling it"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Grid>
