<!--
  Running: what the selected phone runs right now. Filter, apps only, auto
  refresh and the refresh at the top; the list; the actions under it, Kill all
  background last.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource CardPanel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="RUNNING NOW" Style="{StaticResource Caps}" Margin="0,0,0,3"/>
          <TextBlock x:Name="RunningInfo" Style="{StaticResource MutedLine}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     Text="Refresh reads the processes of the selected phone"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="210" VerticalAlignment="Center">
            <TextBox x:Name="RunningFilter" ToolTip="Filter by process name - the text itself, not a pattern. Enter reads the list again."/>
            <TextBlock Text="Filter by process name" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                       FontSize="13" Foreground="{StaticResource MutedText}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=RunningFilter}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <CheckBox x:Name="RunningApps" Content="apps only" IsChecked="True" Margin="14,0,4,0" VerticalAlignment="Center"
                    ToolTip="Hide kernel and native system processes"/>
          <CheckBox x:Name="RunningAuto" Content="auto" Margin="10,0,6,0" VerticalAlignment="Center"
                    ToolTip="Read the list again by itself, every so many milliseconds"/>
          <TextBox x:Name="RunningMs" Text="5000" Width="76" Margin="0,0,10,0" VerticalAlignment="Center"
                   ToolTip="Milliseconds between automatic refreshes (2000 to 60000)"/>
          <Button x:Name="RunningRefresh" Style="{StaticResource IconButton}" Content="&#xE72C;"
                  ToolTip="Refresh the process list (F5)"/>
        </StackPanel>
      </Grid>

      <ListView x:Name="RunningList" Grid.Row="1" SelectionMode="Extended">
        <ListView.ItemContainerStyle>
          <!-- foreground work in green, cached and empty processes in grey -->
          <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Foreground" Value="{Binding Brush}"/>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView>
            <GridViewColumn Header="PROCESS" Width="300" DisplayMemberBinding="{Binding Name}"/>
            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
            <GridViewColumn Header="STATE" Width="100" DisplayMemberBinding="{Binding State}"/>
            <GridViewColumn Header="KIND" Width="90" DisplayMemberBinding="{Binding Kind}"/>
            <GridViewColumn Header="CPU %" Width="70" DisplayMemberBinding="{Binding CpuText}"/>
            <GridViewColumn Header="MEMORY MB" Width="100" DisplayMemberBinding="{Binding MemoryText}"/>
            <GridViewColumn Header="USER" Width="100" DisplayMemberBinding="{Binding User}"/>
          </GridView>
        </ListView.View>
      </ListView>

      <WrapPanel Grid.Row="2" Margin="0,8,0,0">
        <Button x:Name="RunningStop" Content="Force stop" Margin="0,4,8,0"
                ToolTip="am force-stop: stop the selected apps at once, after a question"/>
        <Button x:Name="RunningKill" Content="Kill (background)" Margin="0,4,8,0"
                ToolTip="am kill: only stops the process when it is safe to do so"/>
        <Button x:Name="RunningAppInfo" Content="App info" Margin="0,4,8,0" ToolTip="App info on the phone"/>
        <Border Width="1" Height="22" Background="{StaticResource Border}" Margin="4,4,12,0" VerticalAlignment="Center"/>
        <Button x:Name="RunningCopy" Style="{StaticResource IconButton}" Content="&#xE8C8;" Margin="0,4,8,0"
                ToolTip="Copy the selected rows"/>
        <Button x:Name="RunningExport" Content="Export..." Margin="0,4,8,0" ToolTip="Save the listed processes as CSV"/>
        <Border Width="1" Height="22" Background="{StaticResource Border}" Margin="4,4,12,0" VerticalAlignment="Center"/>
        <Button x:Name="RunningKillAll" Style="{StaticResource DangerButton}" Content="Kill all background" Margin="0,4,8,0"
                ToolTip="am kill-all: stops every safe-to-kill background process at once"/>
      </WrapPanel>
    </Grid>
  </Border>
</Grid>
