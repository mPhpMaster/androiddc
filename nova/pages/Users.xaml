<!--
  Users: the users on the selected phone. The header line and the refresh at
  the top, the list, then the actions - Remove last, in red.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource CardPanel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="USERS ON THIS PHONE" Style="{StaticResource Caps}" Margin="0,0,0,3"/>
          <TextBlock x:Name="UsersState" Style="{StaticResource MutedLine}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     Text="users: unknown"/>
        </StackPanel>
        <Button x:Name="UsersRefresh" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;"
                VerticalAlignment="Center" ToolTip="Refresh the user list (F5)"/>
      </Grid>

      <ListView x:Name="UsersList" Grid.Row="1" SelectionMode="Single">
        <ListView.ItemContainerStyle>
          <!-- the current user in green -->
          <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Foreground" Value="{Binding Brush}"/>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView>
            <GridViewColumn Header="ID" Width="110" DisplayMemberBinding="{Binding IdText}"/>
            <GridViewColumn Header="NAME" Width="260" DisplayMemberBinding="{Binding Name}"/>
            <GridViewColumn Header="STATE" Width="110" DisplayMemberBinding="{Binding State}"/>
            <GridViewColumn Header="KIND" Width="170" DisplayMemberBinding="{Binding Kind}"/>
            <GridViewColumn Header="FLAGS" Width="110" DisplayMemberBinding="{Binding Flags}"/>
          </GridView>
        </ListView.View>
      </ListView>

      <WrapPanel Grid.Row="2" Margin="0,8,0,0">
        <Button x:Name="UsersSwitch" Style="{StaticResource Primary}" Content="Switch to" Margin="0,4,8,0"
                ToolTip="Switch the phone screen to the selected user (a double-click does the same)"/>
        <Button x:Name="UsersAdd" Content="Add user" Margin="0,4,8,0" ToolTip="Add a user (pm create-user)"/>
        <Button x:Name="UsersRename" Content="Rename" Margin="0,4,8,0"
                ToolTip="Rename this user. Android usually refuses it from adb (MANAGE_USERS is a system permission); User settings renames it on the phone."/>
        <Border Width="1" Height="22" Background="{StaticResource Border}" Margin="4,4,12,0" VerticalAlignment="Center"/>
        <Button x:Name="UsersSwitcherOn" Content="Multi-user on" Margin="0,4,8,0"
                ToolTip="Shows the user switcher; the users themselves are kept"/>
        <Button x:Name="UsersSwitcherOff" Content="Multi-user off" Margin="0,4,8,0"
                ToolTip="Hides the user switcher; the users themselves are kept"/>
        <Button x:Name="UsersSettings" Content="User settings" Margin="0,4,8,0" ToolTip="Open the users screen on the phone"/>
        <Border Width="1" Height="22" Background="{StaticResource Border}" Margin="4,4,12,0" VerticalAlignment="Center"/>
        <Button x:Name="UsersRemove" Style="{StaticResource DangerButton}" Content="Remove" Margin="0,4,8,0"
                ToolTip="Delete this user and everything in it"/>
      </WrapPanel>
    </Grid>
  </Border>
</Grid>
