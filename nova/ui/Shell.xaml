<!--
  AndroidDC Nova - the window around the pages.

  Left: the side navigation, filled in from the page registry, and a short
  status. Right, top to bottom: the device card (which phone, its battery,
  signal and screen, and the device picker), the page area, and the activity
  log with the busy strip and the sharing state. The log can be dragged taller
  or folded away.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AndroidDC Nova - Android Device Control"
        Width="1440" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Cloud}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
  <Grid>
    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ============================================== side navigation == -->
      <Border Grid.Column="0" Background="#F0F3F7" BorderBrush="{StaticResource Border}" BorderThickness="1"
              CornerRadius="12" Padding="12,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,22">
            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource Brand}" Effect="{StaticResource SoftShadow}">
              <TextBlock Text="A" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="AndroidDC" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="Device Control" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="8,12,8,2">
            <Border Height="1" Background="{StaticResource Border}" Margin="-8,0,-8,8"/>
            <Button x:Name="SideClassic" Style="{StaticResource Ghost}" Foreground="{StaticResource Ink}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0" Margin="-8,0,-8,8"
                    ToolTip="Close this window and open the classic AndroidDC window: the same tool, with its tabs">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource MutedText}"/>
                <TextBlock Text="Classic window" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
              </StackPanel>
            </Button>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="Sharing" FontSize="12" Foreground="{StaticResource MutedText}"/>
              <TextBlock x:Name="SideSharing" Text="Off" FontSize="12" FontWeight="Medium"
                         Foreground="{StaticResource MutedText}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="Devices" FontSize="12" Foreground="{StaticResource MutedText}"/>
              <TextBlock x:Name="SideDevices" Text="0" FontSize="12" FontWeight="Medium" HorizontalAlignment="Right"/>
            </Grid>
            <Grid>
              <TextBlock Text="Version" FontSize="12" Foreground="{StaticResource MutedText}"/>
              <TextBlock x:Name="SideVersion" Text="" FontSize="12" FontWeight="Medium" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="NavHost"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ======================================================= main ==== -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="14"/>
          <RowDefinition Height="*" MinHeight="300"/>
          <RowDefinition Height="12"/>
          <RowDefinition x:Name="LogRow" Height="190" MinHeight="46"/>
        </Grid.RowDefinitions>

        <!-- the device card -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="DevicePickerToggle" Cursor="Hand" Focusable="True"
                          ToolTip="Pick the device - or several - that the pages act on">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="4,2,10,2">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource Muted}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource Muted}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource Surface}">
                  <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}" FontSize="19" Foreground="{StaticResource Brand}"
                             HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DeviceTitle" Text="No device" Style="{StaticResource H1}"/>
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="11" Margin="8,3,0,0"
                               Foreground="{StaticResource MutedText}"/>
                  </StackPanel>
                  <TextBlock x:Name="DeviceSubtitle" Text="Plug a phone in with USB debugging on" FontSize="12"
                             Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
            </ToggleButton>

            <Popup x:Name="DevicePopup" PlacementTarget="{Binding ElementName=DevicePickerToggle}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   IsOpen="{Binding IsChecked, ElementName=DevicePickerToggle, Mode=TwoWay}">
              <Border Margin="0,8,16,16" Width="700" Style="{StaticResource CardPanel}" Effect="{StaticResource PanelShadow}">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="DEVICES" Style="{StaticResource Caps}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <CheckBox x:Name="AllDevices" Content="All devices" Margin="0,0,12,0"
                                ToolTip="Act on every ready device, whichever is picked"/>
                      <Button x:Name="DeviceRefresh" Style="{StaticResource IconButton}" Content="&#xE72C;"
                              ToolTip="Read the device list again"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedLine}" Margin="2,10,0,0"
                             Text="Ctrl+click or Shift+click picks several; each action then applies to every one. The list follows the cable by itself."/>
                  <ListView x:Name="DeviceList" Height="210" SelectionMode="Extended">
                    <ListView.View>
                      <GridView>
                        <GridViewColumn Header="SERIAL" Width="200" DisplayMemberBinding="{Binding Serial}"/>
                        <GridViewColumn Header="LINK" Width="56" DisplayMemberBinding="{Binding Link}"/>
                        <GridViewColumn Header="MODEL" Width="160" DisplayMemberBinding="{Binding Model}"/>
                        <GridViewColumn Header="ANDROID" Width="74" DisplayMemberBinding="{Binding Android}"/>
                        <GridViewColumn Header="STATE" Width="96" DisplayMemberBinding="{Binding State}"/>
                        <GridViewColumn Header="CLIENT" Width="64" DisplayMemberBinding="{Binding Client}"/>
                      </GridView>
                    </ListView.View>
                  </ListView>
                </DockPanel>
              </Border>
            </Popup>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,12,0">
              <Border x:Name="PillFtp" Style="{StaticResource Pill}" Background="{StaticResource Muted}" Margin="0,2,8,2" Visibility="Collapsed"
                      Cursor="Hand" ToolTip="Click to open FTP. Right-click to start or stop the server.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="PillFtpGlyph" Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource MutedText}"/>
                  <TextBlock x:Name="PillFtpText" Text="FTP off" FontSize="12" FontWeight="Medium" Margin="6,0,0,0"/>
                </StackPanel>
              </Border>
              <Border x:Name="PillBattery" Style="{StaticResource Pill}" Background="{StaticResource Muted}" Margin="0,2,8,2" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE83F;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource MutedText}"/>
                  <TextBlock x:Name="PillBatteryText" FontSize="12" FontWeight="Medium" Margin="6,0,0,0"/>
                </StackPanel>
              </Border>
              <Border x:Name="PillSignal" Style="{StaticResource Pill}" Background="{StaticResource Muted}" Margin="0,2,8,2" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xEC05;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource MutedText}"/>
                  <TextBlock x:Name="PillSignalText" FontSize="12" FontWeight="Medium" Margin="6,0,0,0"/>
                </StackPanel>
              </Border>
              <Border x:Name="PillScreen" Style="{StaticResource Pill}" Background="{StaticResource Muted}" Margin="0,2,0,2" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource MutedText}"/>
                  <TextBlock x:Name="PillScreenText" FontSize="12" FontWeight="Medium" Margin="6,0,0,0"/>
                </StackPanel>
              </Border>
            </WrapPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="HeaderRefresh" Style="{StaticResource IconButton}" Content="&#xE72C;"
                      ToolTip="Read the device list again (F5 reads the page on screen)"/>
              <Button x:Name="HeaderMirror" Style="{StaticResource Primary}" Margin="8,0,0,0"
                      ToolTip="Start scrcpy on every selected device, with the Mirroring settings">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
                  <TextBlock Text="Mirror" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- the pages -->
        <Grid Grid.Row="2" x:Name="PageHost"/>

        <GridSplitter Grid.Row="3" x:Name="LogSplitter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"
                      ToolTip="Drag to give the log more or less room">
          <GridSplitter.Template>
            <ControlTemplate TargetType="GridSplitter">
              <Border Background="Transparent">
                <Border Width="40" Height="4" CornerRadius="2" Background="#C9D1DB"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </GridSplitter.Template>
        </GridSplitter>

        <!-- the activity log -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="16,8,10,8">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Height="30">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Activity log" Style="{StaticResource H2}" VerticalAlignment="Center"/>
              <StackPanel x:Name="BusyStrip" Grid.Column="1" Orientation="Horizontal" Margin="18,0,12,0" Visibility="Hidden">
                <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center"/>
                <TextBlock x:Name="BusyText" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </StackPanel>
              <Border x:Name="SharingPill" Grid.Column="2" Style="{StaticResource Pill}" Background="{StaticResource Muted}"
                      Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Internet sharing from this PC to the phone (Tethering)">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="SharingDot" Width="7" Height="7" Fill="{StaticResource MutedText}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="SharingText" Text="Sharing: off" FontSize="11.5" FontWeight="Medium" Margin="6,0,0,0"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="LogClear" Style="{StaticResource Ghost}" Content="Clear" MinHeight="28" Padding="10,0"
                        ToolTip="Empty the log (Ctrl+L)"/>
                <Button x:Name="LogSave" Style="{StaticResource Ghost}" Content="Save..." MinHeight="28" Padding="10,0"/>
                <Button x:Name="LogFold" Style="{StaticResource IconButton}" Content="&#xE70D;" Width="28" Height="28"
                        Margin="4,0,0,0" FontSize="11" ToolTip="Fold the log away and give its room to the page"/>
              </StackPanel>
            </Grid>
            <ListBox x:Name="LogList" Margin="0,4,0,0" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ScrollViewer Focusable="False" Padding="0,0,6,0">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4,3">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Muted}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"/>
                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11" Foreground="{StaticResource MutedText}"
                               Margin="12,1,0,0"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- the toast -->
    <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,30,0" Visibility="Collapsed"
            Style="{StaticResource CardPanel}" Padding="14,8,6,8" Effect="{StaticResource PanelShadow}">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ToastGlyph" Style="{StaticResource Glyph}" FontSize="17"/>
        <TextBlock x:Name="ToastText" Margin="10,0,6,0" FontWeight="Medium" VerticalAlignment="Center" MaxWidth="420"
                   TextWrapping="Wrap"/>
        <Button x:Name="ToastClose" Style="{StaticResource IconButton}" Background="Transparent" Content="&#xE711;"
                Width="30" Height="30" FontSize="10" ToolTip="Dismiss"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
